# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""
# Microsoft Entra ID (Azure AD) OAuth credentials
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Restrict sign-in to your organization's tenant.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Register these Web redirect URIs in the Entra app:
#   http://localhost:3000/api/auth/callback/microsoft-entra-id
#   https://<your-vercel-domain>/api/auth/callback/microsoft-entra-id
# In App registrations > Token configuration, add the optional ID token
# claims "email" and "xms_edov". The app requires xms_edov=true before it
# links a Microsoft identity to an existing user by email.

# Drizzle / Database
#
# Dev and Prod both run on Supabase (identical behavior; only the data differs).
#
# DATABASE_URL  = pooled connection used by the running app — the Supabase
#   pgBouncer pooler (port 6543), append ?pgbouncer=true.
# DIRECT_URL    = direct, non-pooled connection used ONLY for migrations and
#   Drizzle Studio (Supabase port 5432). Optional — falls back to DATABASE_URL
#   when unset. Always set it for Supabase; migrations via the pooler are flaky.
#
# Supabase example (replace project ref / password / region):
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# External product API (SKU lookup)
#
# The home page resolves a comma-separated list of SKUs against this API via
#   GET ${EXTERNAL_API_BASE_URL}/products?skus=a,b,c   (max 20 SKUs per request)
# sent with `Authorization: Bearer ${EXTERNAL_API_TOKEN}`.
#
# EXTERNAL_API_BASE_URL = base URL, no trailing slash (e.g. https://api.example.com/v1)
# EXTERNAL_API_TOKEN    = bearer token / API key (secret)
#
# Required in production; optional in dev/test so the app boots before the
# integration is configured.
EXTERNAL_API_BASE_URL=""
EXTERNAL_API_TOKEN=""
