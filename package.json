{
  "name": "mm_web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.development -- drizzle-kit migrate --config=drizzle.dev.config.ts",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate --config=drizzle.prod.config.ts",
    "db:studio:dev": "dotenv -e .env.development -- drizzle-kit studio --config=drizzle.dev.config.ts",
    "db:studio:prod": "dotenv -e .env.production -- drizzle-kit studio --config=drizzle.prod.config.ts",
    "db:push:dev": "dotenv -e .env.development -- drizzle-kit push --config=drizzle.dev.config.ts",
    "db:push:prod": "dotenv -e .env.production -- drizzle-kit push --config=drizzle.prod.config.ts",
    "db:seed:dev": "dotenv -e .env.development -- node scripts/seed-user.mjs",
    "db:seed:prod": "dotenv -e .env.production -- node scripts/seed-user.mjs",
    "db:seed:users:dev": "dotenv -e .env.development -- node scripts/seed-users.mjs",
    "db:seed:users:prod": "dotenv -e .env.production -- node scripts/seed-users.mjs",
    "db:seed:clients:dev": "dotenv -e .env.development -- node scripts/seed-clients.mjs",
    "db:seed:clients:prod": "dotenv -e .env.production -- node scripts/seed-clients.mjs",
    "db:seed:products:dev": "dotenv -e .env.development -- node scripts/seed-products.mjs",
    "db:seed:products:prod": "dotenv -e .env.production -- node scripts/seed-products.mjs",
    "dev": "next dev",
    "dev:db:dev": "dotenv -e .env.development -- next dev",
    "dev:db:prod": "dotenv -e .env.production -- next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.7.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "jspdf": "^4.2.1",
    "konva": "^10.7.0",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "19.2.7",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "3.2.4"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@12.5.1"
}
